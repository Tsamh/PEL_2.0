SECRET_KEY=changez-moi
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Email SMTP (laisser EMAIL_HOST_USER vide pour afficher les emails dans la console)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=PEL <noreply@pel.com>

# Frontend URL (pour les liens d'activation/reset)
FRONTEND_URL=http://localhost:5173

# Cache : la limite d'essais du code d'accès des quiz utilise le cache Django.
# Le cache local par défaut suffit avec un seul processus ; avec plusieurs processus,
# configurer un cache partagé (Redis ou Memcached) dans CACHES.

# Exécution du code des étudiants (Docker obligatoire ; jamais d'exécution sans isolation).
# PEL_EXECUTEUR=docker
# Images par langage (à télécharger avec docker pull) :
# PEL_IMAGE_PYTHON=python:3.12-alpine
# PEL_IMAGE_JAVASCRIPT=node:20-alpine
# PEL_IMAGE_C=gcc:13
# PEL_IMAGE_CPP=gcc:13
# PEL_IMAGE_JAVA=eclipse-temurin:21-jdk
# Nombre de fils du worker executer_file (1 avec SQLite) :
# PEL_WORKERS_EXECUTION=2
# La limite de 20 exécutions par minute utilise aussi le cache : cache partagé avec plusieurs processus.
